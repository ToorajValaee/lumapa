FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-bookworm-slim AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_LUMAPA_HORIZON_URL=https://horizon.badje.ir
ARG NEXT_PUBLIC_LUMAPA_NETWORK_PASSPHRASE="Lumapa Network ; July 2026"
ARG NEXT_PUBLIC_LUMAPA_NATIVE_SYMBOL=BADJ
ARG NEXT_PUBLIC_LUMAPA_NATIVE_NAME="Lumapa native"
ARG NEXT_PUBLIC_LUMAPA_EXPLORER_URL=
ARG NEXT_PUBLIC_LUMAPA_WALLET_URL=https://app.lumapa.ir
ARG NEXT_PUBLIC_LUMAPA_PUBLIC_URL=https://lumapa.ir
ARG NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/YOUR_ORG/YOUR_REPO
ENV NEXT_PUBLIC_LUMAPA_HORIZON_URL=$NEXT_PUBLIC_LUMAPA_HORIZON_URL
ENV NEXT_PUBLIC_LUMAPA_NETWORK_PASSPHRASE=$NEXT_PUBLIC_LUMAPA_NETWORK_PASSPHRASE
ENV NEXT_PUBLIC_LUMAPA_NATIVE_SYMBOL=$NEXT_PUBLIC_LUMAPA_NATIVE_SYMBOL
ENV NEXT_PUBLIC_LUMAPA_NATIVE_NAME=$NEXT_PUBLIC_LUMAPA_NATIVE_NAME
ENV NEXT_PUBLIC_LUMAPA_EXPLORER_URL=$NEXT_PUBLIC_LUMAPA_EXPLORER_URL
ENV NEXT_PUBLIC_LUMAPA_WALLET_URL=$NEXT_PUBLIC_LUMAPA_WALLET_URL
ENV NEXT_PUBLIC_LUMAPA_PUBLIC_URL=$NEXT_PUBLIC_LUMAPA_PUBLIC_URL
ENV NEXT_PUBLIC_GITHUB_REPO_URL=$NEXT_PUBLIC_GITHUB_REPO_URL
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV LUMAPA_DATA_DIR=/data
RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs \
  && install -d -o nextjs -g nodejs /app /data
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
